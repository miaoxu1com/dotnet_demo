<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XmindToExcelConverter.ViewModels"
        xmlns:models="using:XmindToExcelConverter.Models"
        mc:Ignorable="d"
        x:Class="XmindToExcelConverter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="XMind to Excel Converter"
        Width="600" Height="645"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ScrollViewer>
            <Grid RowDefinitions="Auto,*,Auto,*" Margin="10">
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Config.Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FieldConfig">
                            <!-- 动态添加控件无法预览效果,运行时才会显示 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                                <TextBlock Text="{Binding Label}" 
                                         Grid.Column="0"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                                <TextBox Text="{Binding Name}" 
                                         Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,10">
                    <TextBlock Text="已选择文件列表：" 
                             Grid.Row="0"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1"
                            AcceptsReturn="True" 
                            TextWrapping="Wrap"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsReadOnly="True"
                            Text="{Binding SelectedFilePath}"/>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10">
                    <Button Name="FileBtn" Content="选择思维导图文件" 
                            Grid.Column="0" 
                            HorizontalAlignment="Center" 
                            Command="{Binding SelectXmindFileCommand}"
                            Margin="5"/>
                    <Button Content="生成Excel用例" 
                            Grid.Column="1" 
                            HorizontalAlignment="Center"  
                            Command="{Binding GenerateExcelCommand}"
                            Margin="5"/>
                </Grid>
                <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="0,10">
                    <TextBlock Name="SelectedList" Text="已生成的案例列表：" 
                             Grid.Row="0"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1"
                            AcceptsReturn="True" 
                            TextWrapping="Wrap"
                            HorizontalAlignment="Stretch"
                            IsReadOnly="True"
                            VerticalAlignment="Stretch"
                            Text="{Binding OutFilePath}"
                            />
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
