<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:md_to_test_case.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:md_to_test_case.Controls;assembly=md_to_test_case"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="md_to_test_case.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title=""
        Width="432" Height="150"
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- 自定义标题栏 + 内容区 -->
    <Grid>

      <!-- 内容区：矩形与窗口内容边界保持 5px 间距 -->
      <Grid>
        <Rectangle
          Margin="5"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Fill="Transparent"
          Stroke="Gray"
          StrokeThickness="2"
          StrokeDashArray="6,3"/>

        <!-- 把文字按矩形宽高均匀分布 -->
        <ItemsControl ItemsSource="{Binding DisplayChars, ElementName=Root}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:EvenGridPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Opacity="0.6" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
</Window>
